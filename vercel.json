{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app.py": {
      "maxDuration": 120,
      "includeFiles": "{ayo/**,templates/**,static/**,migrations/**,alembic.ini}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]
    }
  ]
}
