# Generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=REPLACE_WITH_RANDOM_48_BYTES
# Generate with python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# https URL required outside local testing; set exact Shopify allowed redirect URL to ${APP_ORIGIN}/shopify/callback
APP_ORIGIN=http://localhost:8000
# Local only; production should use managed PostgreSQL with a durable secret and migrations
DATABASE_URL=sqlite:///./ayo.db
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
# Set in production
ENVIRONMENT=development

# No provider calls occur with these defaults. Set keys through secure runtime
# configuration only AFTER the owner approves provider spend and source policy.
FIRECRAWL_API_KEY=
AYO_PROVIDER_SPEND_AUTHORIZED=0
AYO_RESEARCH_EGRESS_POLICY=
AYO_RESEARCH_APPROVED_HOSTS=
# Initial public reports always use Gemini. This selector controls optional
# private-workspace analysis only; no silent secondary-model fallback occurs.
AYO_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Transactional account mail only. This is independent of outreach permission.
RESEND_API_KEY=
MAIL_FROM=
AYO_MAIL_SEND_AUTHORIZED=0

# Operator attestation after reviewing provider data handling for the selected tier.
AYO_AI_DATA_POLICY=
# Strict pre-dispatch budgets. Leave blank until pricing/operation bounds and a
# maximum test budget are reviewed and separately authorized. No example rates.
# Integers in USD micro-units; 1000000 micro-units = USD 1.
AYO_REQUEST_BUDGET_MICROUSD=
AYO_REQUEST_CALL_LIMIT=
AYO_FIRECRAWL_DAILY_BUDGET_MICROUSD=
AYO_FIRECRAWL_DAILY_CALL_LIMIT=
AYO_FIRECRAWL_SCOPE_DAILY_BUDGET_MICROUSD=
AYO_FIRECRAWL_SCOPE_DAILY_CALL_LIMIT=
AYO_FIRECRAWL_BUDGET_POLICY_VERSION=
# Future Unix UTC epoch; review expiry is enforced before each reservation.
AYO_FIRECRAWL_BUDGET_POLICY_VALID_UNTIL=
AYO_FIRECRAWL_SEARCH_RESERVATION_MICROUSD=
AYO_FIRECRAWL_FETCH_RESERVATION_MICROUSD=
AYO_GEMINI_DAILY_BUDGET_MICROUSD=
AYO_GEMINI_DAILY_CALL_LIMIT=
AYO_GEMINI_SCOPE_DAILY_BUDGET_MICROUSD=
AYO_GEMINI_SCOPE_DAILY_CALL_LIMIT=
AYO_GEMINI_BUDGET_POLICY_VERSION=
AYO_GEMINI_BUDGET_POLICY_VALID_UNTIL=
AYO_GEMINI_ANALYZE_RESERVATION_MICROUSD=
# Optional private analysis only; no secondary-provider fallback in public reports.
AYO_CLAUDE_DAILY_BUDGET_MICROUSD=
AYO_CLAUDE_DAILY_CALL_LIMIT=
AYO_CLAUDE_SCOPE_DAILY_BUDGET_MICROUSD=
AYO_CLAUDE_SCOPE_DAILY_CALL_LIMIT=
AYO_CLAUDE_BUDGET_POLICY_VERSION=
AYO_CLAUDE_BUDGET_POLICY_VALID_UNTIL=
AYO_CLAUDE_ANALYZE_RESERVATION_MICROUSD=
